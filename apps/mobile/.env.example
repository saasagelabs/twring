# Local development. Copy to .env.local (git-ignored) and pick ONE API_BASE_URL below.
# EXPO_PUBLIC_* values are inlined into the JS bundle by Metro when you run `pnpm start`.
# They are PUBLIC: never put a secret here. Development builds read these local values,
# not eas.json, because their JS is served by your Metro server.
EXPO_PUBLIC_CORD_ENV=development

# Android emulator -> gateway on this machine:
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080
# Android phone over USB: run `pnpm android:usb-reverse` (adb reverse tcp:8080 tcp:8080), then:
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
# Phone on the same Wi-Fi (Android or iOS): your machine's LAN address. Keep it in .env.local only.
# EXPO_PUBLIC_API_BASE_URL=http://<your-lan-ip>:8080
# Any network / iOS device without LAN access: an HTTPS tunnel to port 8080.
# EXPO_PUBLIC_API_BASE_URL=https://<your-tunnel-host>

EXPO_PUBLIC_LIVEKIT_PUBLIC_URL=
EXPO_PUBLIC_SENTRY_DSN=

# Sign-in (ADR-021): Google via Supabase Auth. All public values (the publishable key is meant to
# ship in apps). Sign-in turns on only when all three are set; then run the gateway with
# AUTH_MODE=supabase. To dogfood signed out against an AUTH_MODE=dev gateway, empty
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID in your .env.local.
EXPO_PUBLIC_SUPABASE_URL=https://gifdayffysmzskxdgmgp.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_JOl2BTQPnkT0cN4lQA3Lrw_7lZRFovX
# Google Cloud OAuth client of type "Web application" (its id, not the Android client's).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=605371988164-rtamegb6hegcll2kbu2e2i7o1udaordu.apps.googleusercontent.com
# iOS OAuth client id; also sets the iOS URL scheme at build time. Android does not need it.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Build-time only (not bundled). Identity variant: development | staging | production.
APP_VARIANT=development
# Set these plus SENTRY_AUTH_TOKEN (EAS secret) to enable source-map upload.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_DISABLE_AUTO_UPLOAD=true
