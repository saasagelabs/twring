<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Keeps a live call running with the screen off or the app in the background (ADR-019). -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <!-- Incoming agent calls ring over the lock screen (Android 14 grants this to calling apps). -->
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
  <uses-permission android:name="android.permission.VIBRATE" />

  <application>
    <service
      android:name="expo.modules.cordcallservice.CallForegroundService"
      android:exported="false"
      android:foregroundServiceType="microphone" />
    <!-- The app's only FirebaseMessagingService (Ring.kt); no other dependency registers one. -->
    <service
      android:name="expo.modules.cordcallservice.RingMessagingService"
      android:exported="false">
      <intent-filter>
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>
    <receiver
      android:name="expo.modules.cordcallservice.RingDeclineReceiver"
      android:exported="false" />
  </application>
</manifest>
