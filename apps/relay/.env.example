# The Twring ring relay (apps/relay). Copy to .env (git-ignored). Never commit real values.
RELAY_ENV=development
HOST=0.0.0.0
PORT=8090
LOG_LEVEL=info
# Proxies whose X-Forwarded-For is trusted for rate limits: false, or addresses like 127.0.0.1.
TRUST_PROXY=false
# One SQLite file holds every install.
RELAY_DB_FILE=./data/relay.db
# The address email links point at.
RELAY_PUBLIC_URL=http://localhost:8090
# Every new install is free until this date (ISO date). Existing installs keep their stored date.
RELAY_FREE_UNTIL=2027-12-31
# Bearer token for /v1/admin routes, at least 32 characters. Generate one; never commit it.
RELAY_ADMIN_TOKEN=
# Optional JSON file of partners: [{ "id": "acme", "token_sha256": "<hex SHA-256 of the token>" }]
# RELAY_PARTNER_TOKENS_FILE=/var/lib/twring-relay/partners.json
# Verification email through Resend, with the relay's own key (never production's). Leave it
# empty in development (emails are skipped).
RELAY_RESEND_API_KEY=
# New installs per hour across every address, and verification emails per 24 hours.
RELAY_INSTALLS_PER_HOUR=200
RELAY_EMAILS_PER_DAY=90
RELAY_EMAIL_FROM=Twring <invites@saasage.in>
# Push services for rings (Twring's own credentials). Paths to files, never their contents.
# Unset: that platform gets no rings.
RELAY_FCM_SERVICE_ACCOUNT_FILE=
RELAY_APNS_KEY_FILE=
RELAY_APNS_KEY_ID=
RELAY_APNS_TEAM_ID=
RELAY_APNS_BUNDLE_ID=com.twring.app
RELAY_APNS_ENV=production
