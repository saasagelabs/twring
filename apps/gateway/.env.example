# Local development. Copy to .env (git-ignored). Never commit real values.
CORD_ENV=development
# Sign-in (ADR-021). dev: every request is the local `dev-user` (no sign-in; the default here).
# supabase: verify Google sign-in tokens from the Supabase project below (the mobile app then
# needs its EXPO_PUBLIC_SUPABASE_* values too). Staging and production must use supabase.
AUTH_MODE=dev
SUPABASE_URL=
# Optional invite-only beta gate. Leave unset for development and staging.
# BETA_MEMBERS_FILE=/var/lib/cord/beta-members.json
CORD_RELEASE=dev
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
# Optional in development/staging, required in production.
SENTRY_DSN=

# LiveKit (Milestone 1). Leave all three empty to run without calling (/v1/calls answers 503).
# Use your own staging project's values; never commit them.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Call guards. Defaults shown.
CALLS_ENABLED=true
CALL_MAX_CONCURRENT=4
CALL_MAX_DURATION_S=1800
CALL_TOKEN_TTL_S=600
CALL_CREATE_RATE_PER_MINUTE=10
# Hard cap on one agent turn (seconds), even while the agent keeps working.
AGENT_TURN_MAX_S=600
# Presence cues while the agent works: a soft "heard you" tone and spoken "Still working" lines.
PRESENCE_CUES=on
# A short spoken "Okay, one moment." when the agent is still silent 1.5 s after you speak.
PRESENCE_ACK=on
# Hold a one- or two-word normal turn briefly for more speech; 0 sends it immediately.
# SHORT_TURN_HOLD_MS=800
# Kill switches for outbound connection tests and voice previews. Defaults shown.
AGENT_TESTS_ENABLED=true
VOICE_SAMPLES_ENABLED=true
# Per-client rate limits, requests per minute (429 rate_limited beyond them). Defaults shown.
AGENT_WRITE_RATE_PER_MINUTE=30
AGENT_TEST_RATE_PER_MINUTE=6
API_READ_RATE_PER_MINUTE=120
VOICE_SAMPLE_RATE_PER_MINUTE=20
DATA_DELETE_RATE_PER_MINUTE=3
# Per-user allowance each UTC day (0 = unlimited): calling seconds, and calls started.
DAILY_CALL_SECONDS_PER_USER=3600
DAILY_CALLS_PER_USER=50
# Service-wide calling seconds per UTC day (0 = no cap): past it, new calls get service_busy.
# Wave 1: about 3,000 minutes (180000) costs about $57 at list prices.
SERVICE_DAILY_CALL_SECONDS=0
# Service alerts (80% of the daily cap; live calls near CALL_MAX_CONCURRENT). Uses Resend with
# RESEND_API_KEY and WAITLIST_NOTIFY_FROM.
OWNER_ALERT_TO=
# Printed on the public /privacy and /account-deletion pages. TODO: set the operator's legal name.
CORD_OPERATOR_NAME=[OPERATOR NAME]
# Optional https link for the operator's name on those pages, e.g. their X profile.
# CORD_OPERATOR_URL=
CORD_SUPPORT_EMAIL=support@twring.com
CONNECTOR_CLAIM_RATE_PER_MINUTE=10
CONNECTOR_SOCKET_RATE_PER_MINUTE=30
# Usage cost estimate rates in USD (0 = unknown, left out of the estimate). No vendor prices ship.
CORD_RATE_STT_PER_MIN=0
CORD_RATE_TTS_PER_1K_CHARS=0
CORD_RATE_ROOM_PER_MIN=0
# repeat = Twring transcribes each finished sentence and says it back (needs Deepgram);
# echo = caller hears themselves ~0.6 s later; tone = chime only; off = silent.
# native = talk to the Twring Native (cord-agent/1) agent below (needs Deepgram).
# rest = talk to the REST + SSE (cord-rest/1) agent below (needs Deepgram).
# Leave empty for the default: repeat with Deepgram configured, otherwise echo.
GATEWAY_AUDIO_TEST_MODE=

# Twring Native agent (Milestone 5), required when GATEWAY_AUDIO_TEST_MODE=native.
# Locally: run `pnpm fake-agent`, then AGENT_NATIVE_URL=ws://127.0.0.1:8787.
AGENT_NATIVE_URL=
# Bearer token the agent expects. Server-side secret: put it in .env, never here.
AGENT_NATIVE_TOKEN=

# REST + SSE agent (Milestone 6), required when GATEWAY_AUDIO_TEST_MODE=rest.
# Locally: run `pnpm fake-rest-agent`, then AGENT_REST_URL=http://127.0.0.1:8789/cord/turns.
AGENT_REST_URL=
# Bearer token the agent expects. Server-side secret: put it in .env, never here.
AGENT_REST_TOKEN=

# Deepgram (Milestone 2): speech-to-text (Flux) and text-to-speech (Flux TTS). Server-side only.
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=flux-general-en
DEEPGRAM_TTS_MODEL=flux-haley-en

# Cartesia Sonic (ADR-020): optional second TTS provider. Empty hides its voices. Server-side
# secret: put the key in .env, never here.
CARTESIA_API_KEY=
CARTESIA_TTS_MODEL=sonic-3.6
# Speaking pace, 0.6–1.5 (1 = the voice's own pace). Lower is slower and easier to follow.
CARTESIA_TTS_SPEED=1

# Saved agents (Milestone 7). Stored as JSON files under CORD_DATA_DIR (default ./data).
CORD_DATA_DIR=
# Browser origins allowed to POST /v1/waitlist. Exact HTTPS origins; development also allows http://localhost:<port>.
WAITLIST_ALLOWED_ORIGINS=https://twring.com,https://www.twring.com
# Optional owner email for new requests. Set all three to enable.
# RESEND_API_KEY=<resend-api-key>
# WAITLIST_NOTIFY_TO=support@twring.com
# WAITLIST_NOTIFY_FROM=Twring alerts <alerts@saasage.in>
# 32 random bytes, base64: encrypts saved agent credentials. Server secret: put it in .env, never here.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Without it, /v1/agents answers 503.
CORD_CREDENTIALS_KEY=
# Rotation: bump CORD_CREDENTIALS_KEY_VERSION and move the old key to CORD_CREDENTIALS_OLD_KEYS
# as version:key pairs (e.g. 1:<old key>) until every saved credential has been re-entered.
CORD_CREDENTIALS_KEY_VERSION=1
CORD_CREDENTIALS_OLD_KEYS=
# Set true only behind a reverse proxy you control, or list its addresses (127.0.0.1,10.0.0.0/8).
# Production refuses true: list the proxy addresses.
TRUST_PROXY=false

# Agent rings the owner (ADR-024): path to the Firebase service account JSON (a server file,
# never its contents). Unset: rings work but are not pushed.
FCM_SERVICE_ACCOUNT_FILE=
# iPhone rings and notifications: the APNs .p8 key file, its Key ID and
# the Apple Team ID. Unset: iPhones get no rings or notifications.
APNS_KEY_FILE=
APNS_KEY_ID=
APNS_TEAM_ID=
# APNS_BUNDLE_ID=com.twring.app
# APNS_ENV=production
# Sign in with Apple: the "Twring sign in" .p8 key file, its Key
# ID and the Apple Team ID. Ends an Apple account's sign-in when the account is deleted.
APPLE_SIGNIN_KEY_FILE=
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_TEAM_ID=
# APPLE_SIGNIN_CLIENT_ID=com.twring.app

# Speech keys (ADR-033): lets a person add their own Deepgram or Cartesia key in the app. Off unless true.
# SPEECH_KEYS_ENABLED=false
# Optional xAI listening settings (used only when a person listens on their own xAI key). Never put a key here.
# XAI_STT_ENDPOINTING_MS=400
# XAI_STT_SMART_TURN=0.5   # 0 to 1; unset = off
# XAI_STT_SMART_TURN_TIMEOUT_MS=

# Self-hosted server. Hosted Twring leaves
# all of this unset. The installer writes these; paths are files on the server, never their contents.
# TWRING_MODE=selfhost
# AUTH_MODE=pairing
# TWRING_SERVER_KEY_FILE=/data/server-key.pem
# TWRING_ADMIN_TOKEN=            # at least 32 random characters
# TWRING_RELAY_KEY_FILE=/data/relay-key
# TWRING_AUDIO=own               # own (your LiveKit) or twring
# CORD_PUBLIC_URL=https://twring.example.com   # required in production; PORT sets the listen port
# TWRING_SPACE_ID=default
# XAI_API_KEY=                   # this server's own xAI key (or set DEEPGRAM_API_KEY)
