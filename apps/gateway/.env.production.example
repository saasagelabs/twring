# Production template (Twring's operations notes, private). Real values live in the
# host's secret store, never in git. The gateway refuses to start if a required value is missing,
# an endpoint is not TLS, a development setting is present, or the credentials key is weak.
NODE_ENV=production
CORD_ENV=production
CORD_RELEASE=
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
# Required in production (https://).
SENTRY_DSN=
# Required in production; LIVEKIT_URL must be wss://.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Required in production.
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=flux-general-en
DEEPGRAM_TTS_MODEL=flux-haley-en
# Sign-in (ADR-021): Google via Supabase Auth. Required; the URL is public, not a secret.
AUTH_MODE=supabase
SUPABASE_URL=https://gifdayffysmzskxdgmgp.supabase.co
# Required: a folder on the persistent disk, and a freshly generated 32-byte base64 key.
CORD_DATA_DIR=/var/lib/cord
CORD_CREDENTIALS_KEY=
CORD_CREDENTIALS_KEY_VERSION=1
CORD_CREDENTIALS_OLD_KEYS=
# The reverse proxy's address(es); production refuses true.
TRUST_PROXY=127.0.0.1
# Kill switches.
CALLS_ENABLED=true
AGENT_TESTS_ENABLED=true
VOICE_SAMPLES_ENABLED=true
# Limits (defaults shown).
CALL_MAX_CONCURRENT=4
CALL_MAX_DURATION_S=1800
CALL_CREATE_RATE_PER_MINUTE=10
# Hard cap on one agent turn (seconds), even while the agent keeps working.
AGENT_TURN_MAX_S=600
# Hold a one- or two-word normal turn briefly for more speech; 0 sends it immediately.
# SHORT_TURN_HOLD_MS=800
AGENT_WRITE_RATE_PER_MINUTE=30
AGENT_TEST_RATE_PER_MINUTE=6
API_READ_RATE_PER_MINUTE=120
VOICE_SAMPLE_RATE_PER_MINUTE=20
DATA_DELETE_RATE_PER_MINUTE=3
# Per-user allowance each UTC day (0 = unlimited): calling seconds, and calls started.
DAILY_CALL_SECONDS_PER_USER=3600
DAILY_CALLS_PER_USER=50
# Printed on the public /privacy and /account-deletion pages.
CORD_OPERATOR_NAME=@rishflips
CORD_OPERATOR_URL=https://x.com/rishflips
CORD_SUPPORT_EMAIL=support@twring.com
# Optional owner email for new access requests. Set all three to enable. With BETA_MEMBERS_FILE
# too, requests arrive in one combined email and approved people get their invite by email.
# RESEND_API_KEY=<resend-api-key>
# WAITLIST_NOTIFY_TO=support@twring.com
# WAITLIST_NOTIFY_FROM=Twring alerts <alerts@saasage.in>
# INVITE_FROM=Twring <invites@saasage.in>
# Let people in without approving each one: app sign-ins get in at once, website requests get
# their code by email, each up to this many a day (0 = off: the owner approves with the operations scripts).
AUTO_ADMIT_PER_DAY=50
# TWRING_DOWNLOAD_URL=https://twring.com/downloads/twring-0.1.0-b10.apk
# TWRING_TESTFLIGHT_URL=https://testflight.apple.com/join/<code>
# Never set in production: GATEWAY_AUDIO_TEST_MODE, AGENT_NATIVE_*, AGENT_REST_*,
# DEBUG_AUDIO_CAPTURE_DIR.

# Agent rings the owner (ADR-024): path to the Firebase service account JSON (a server file,
# never its contents). Unset: rings work but are not pushed.
FCM_SERVICE_ACCOUNT_FILE=

# End-of-turn confidence for Flux (0.5-1.0). 0.85 measured on device: mid-sentence pauses of
# 0.7-1.4 s no longer cut the owner off; replies start a little later. Unset = Flux default 0.7.
DEEPGRAM_STT_EOT_THRESHOLD=0.85

# Speech keys (ADR-033): lets a person add their own Deepgram or Cartesia key in the app. Off until the owner turns it on.
# SPEECH_KEYS_ENABLED=false
# Optional xAI listening settings (used only when a person listens on their own xAI key). Never put a key here.
# XAI_STT_ENDPOINTING_MS=400
# XAI_STT_SMART_TURN=0.5   # 0 to 1; unset = off
# XAI_STT_SMART_TURN_TIMEOUT_MS=
