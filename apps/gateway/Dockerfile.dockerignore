# Build context for apps/gateway/Dockerfile (the repository root). Keep secrets and bulky
# outputs out of the image build.
.git
**/node_modules
**/dist
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
**/*.pem
**/*.key
**/*.jks
**/*.keystore
**/*.p12
apps/gateway/data
apps/mobile/android
apps/mobile/ios
apps/mobile/assets
apps/site
docs
.superpowers
.claude
.codex
coverage
