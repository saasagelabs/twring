#!/bin/sh
# Test stand-in for curl: records the call; serves versions.json and the connector from STUB_*.
{
  printf '@@ curl\n'
  for a in "$@"; do printf '%s\n' "$a"; done
} >>"$STUB_DIR/calls.log"
out=""
url=""
prev=""
for a in "$@"; do
  [ "$prev" = -o ] && out=$a
  case $a in https://*) url=$a ;; esac
  prev=$a
done
case $url in
  */versions.json) [ -n "${STUB_VERSIONS:-}" ] || exit 22; body=$STUB_VERSIONS ;;
  */twring-connect.mjs) body=${STUB_CONNECT:-connector} ;;
  */kit.tar.gz)
    [ -n "$out" ] && [ -f "${STUB_KIT:-}" ] || exit 22
    cp "$STUB_KIT" "$out"
    exit 0
    ;;
  *) exit 22 ;;
esac
if [ -n "$out" ]; then printf '%s' "$body" >"$out"; else printf '%s' "$body"; fi
